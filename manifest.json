{
  "manifest_version": "0.3",
  "name": "charmshots",
  "display_name": "Charmshots",
  "version": "1.2.0",
  "description": "Connect your Charmshots account to an MCP client.",
  "long_description": "get_profile reads your account. list_photoshoots, get_photoshoot and list_photos browse existing owned outputs with signed-in download links. No image generation or credit spending.",
  "author": {
    "name": "Codex"
  },
  "homepage": "https://charmshots.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/charmshots/mcp-server"
  },
  "icon": "icon.png",
  "server": {
    "type": "node",
    "entry_point": "server/index.js",
    "mcp_config": {
      "command": "node",
      "args": [
        "${__dirname}/server/index.js"
      ]
    }
  },
  "compatibility": {
    "platforms": [
      "darwin",
      "win32",
      "linux"
    ],
    "runtimes": {
      "node": ">=22"
    }
  },
  "license": "MIT"
}
